# ===== הגשר =====
PORT=8787
# חובה – זהה ל"סוד לחתימה" (CONNECTOR_SECRET) באפליקציה
BRIDGE_SECRET=
# לא חובה – זהה ל"טוקן גישה" באפליקציה
BRIDGE_TOKEN=
# איפה נשמר המצב (כפילויות, מה טופל, איזה חשבון כתב באיזה שרשור)
BRIDGE_STATE_FILE=./data/bridge-state.json
# on = חשבון אחד לכל שרשור (מומלץ)
ONE_ACCOUNT_PER_THREAD=on
# off = כל ההודעות שלא טופלו (ברירת מחדל) · on = רק ההודעה האחרונה בכל שרשור
LATEST_PER_THREAD=off

# ===== חשבונות =====
# או קובץ accounts.json (ראו accounts.example.json), או JSON כאן:
# ACCOUNTS=[{"id":"business","label":"עסקי","username":"בונה מערכות","default":true},{"id":"personal","label":"אישי","username":"אברימי"}]
BRIDGE_ACCOUNTS_FILE=./accounts.json

# ===== המתאם =====
# memory = פורום מדומה (הדגמה/בדיקות) · rest = פורום עם API · ./my-adapter.js = מתאם משלך
ADAPTER=memory
FORUM_API_BASE=https://sandbox-forum.example/api
# נתיבים (ברירות מחדל)
# FORUM_EP_NEW=/posts/new?since={since}&limit={limit}
# FORUM_EP_REPLY=/threads/{threadId}/replies
# FORUM_EP_LIKE=/posts/{postId}/like
# FORUM_EP_THREAD=/forums/{forum}/threads
# FORUM_EP_ME=/me
# FORUM_EP_POSTS=/threads/{threadId}/posts
# FORUM_EP_SEARCH=/search?q={q}&author={author}&from={from}&to={to}
# FORUM_EXTRA_HEADERS={"x-app":"bot"}
# FORUM_TIMEOUT_MS=15000

# ===== הזדהות לכל חשבון (סודות – רק כאן, לא בקבצים) =====
# החשבון הראשון:
AUTH_TOKEN=
SESSION_COOKIE=
# שאר החשבונות: <שם>_<מזהה החשבון באותיות גדולות>
AUTH_TOKEN_PERSONAL=
SESSION_COOKIE_PERSONAL=
